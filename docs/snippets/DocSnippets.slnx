<!-- Mini-solution for the documentation-snippet harness. Deliberately NOT part of
     ProcessKit.slnx: the harness is generated build-time scaffolding, so it must never
     join the library's build graph, `dotnet test`, packing or ApiCompat. Same shape as
     samples/Samples.slnx - BuildDependency entries build the referenced libraries first,
     which is what the assembly `Reference` + AssemblySearchPaths convention needs. -->
<Solution>
	<Folder Name="/Harness/">
		<Project Path="DocSnippets.FSharp/DocSnippets.FSharp.fsproj">
			<BuildDependency Project="../../src/ProcessKit/ProcessKit.fsproj" />
			<BuildDependency Project="../../src/ProcessKit.Testing/ProcessKit.Testing.fsproj" />
			<BuildDependency Project="../../src/ProcessKit.Extensions.DependencyInjection/ProcessKit.Extensions.DependencyInjection.fsproj" />
			<BuildDependency Project="../../src/ProcessKit.Extensions.Hosting/ProcessKit.Extensions.Hosting.fsproj" />
		</Project>
		<Project Path="DocSnippets.CSharp/DocSnippets.CSharp.csproj">
			<BuildDependency Project="../../src/ProcessKit/ProcessKit.fsproj" />
			<BuildDependency Project="../../src/ProcessKit.Testing/ProcessKit.Testing.fsproj" />
			<BuildDependency Project="../../src/ProcessKit.Extensions.DependencyInjection/ProcessKit.Extensions.DependencyInjection.fsproj" />
			<BuildDependency Project="../../src/ProcessKit.Extensions.Hosting/ProcessKit.Extensions.Hosting.fsproj" />
		</Project>
	</Folder>
	<Project Path="../../src/ProcessKit/ProcessKit.fsproj" />
	<Project Path="../../src/ProcessKit.Testing/ProcessKit.Testing.fsproj">
		<BuildDependency Project="../../src/ProcessKit/ProcessKit.fsproj" />
	</Project>
	<Project Path="../../src/ProcessKit.Extensions.DependencyInjection/ProcessKit.Extensions.DependencyInjection.fsproj">
		<BuildDependency Project="../../src/ProcessKit/ProcessKit.fsproj" />
	</Project>
	<Project Path="../../src/ProcessKit.Extensions.Hosting/ProcessKit.Extensions.Hosting.fsproj">
		<BuildDependency Project="../../src/ProcessKit/ProcessKit.fsproj" />
	</Project>
</Solution>
